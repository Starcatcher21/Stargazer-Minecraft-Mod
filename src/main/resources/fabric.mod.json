{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",

  "name": "${name}",
  "description": "${description}",
  "authors": [
    "Starcatcher"
  ],

  "license": "MIT",
  "icon": "assets/${id}/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "${group}.${id}.Stargazer"
    ],
    "client": [
      "${group}.${id}.StargazerClient"
    ],
    "fabric-datagen": [
      "${group}.${id}.StargazerDataGenerator"
    ],
    "rei_client": [
      "${group}.${id}.compat.StargazerREIClient"
    ],
    "rei_common": [
      "${group}.${id}.compat.StargazerREICommon"
    ]
  },
  "mixins": [
    "${id}.mixins.json"
  ],
  "accessWidener": "stargazer.accesswidener",
  "depends": {
    "fabricloader": "*",
    "fabric-api": ">=${fabricVersion}",
    "minecraft": ">=${minecraftVersionVirtual}",
		"architectury": ">=21.0.7",
    "fabric-api": "*",
    "geckolib": ">=5.5.3",
    "starlib": ">=1.0.4"
  }
}
