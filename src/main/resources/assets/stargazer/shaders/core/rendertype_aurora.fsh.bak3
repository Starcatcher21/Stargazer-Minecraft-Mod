#version 151

// Large scale kept for sweeping fluid movements
#define NOISE_SCALE 0.6
#define ANIMATION_SPEED 1.1

#moj_import <minecraft:fog.glsl>
#moj_import <minecraft:projection.glsl>
#moj_import <minecraft:dynamictransforms.glsl>
#moj_import <minecraft:globals.glsl>

in vec4 vertexColor;
in vec2 texCoord0;
in vec4 lightMapColor;
in vec3 positionXYZ;

uniform sampler2D Sampler0;

out vec4 fragColor;

// Simple 2D Pseudo-random noise function
float noise(in vec2 uv) {
return fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453123);
}

// Smooth 2D Value Noise for fluid continuity
float smoothNoise(in vec2 uv) {
vec2 i = floor(uv);
vec2 f = fract(uv);
f = f * f * (3.0 - 2.0 * f);

float a = noise(i);
float b = noise(i + vec2(1.0, 0.0));
float c = noise(i + vec2(0.0, 1.0));
float d = noise(i + vec2(1.0, 1.0));

return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// 6-Octave FBM optimized for continuous fluid shapes
float fluidFBM(in vec2 uv) {
float value = 0.0;
float amplitude = 0.5;
for (int i = 0; i < 6; i++) {
value += amplitude * smoothNoise(uv);
uv *= 2.0;
amplitude *= 0.5;
}
return value;
}

// Converts Hue, Saturation, and Value to RGB
vec3 hsv2rgb(vec3 c) {
vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void main() {
// 1. Sample the base texture color
vec4 baseColor = texture(Sampler0, texCoord0);

// 2. Setup animation time
float time = GameTime * 1200.0 * ANIMATION_SPEED;

// --- WORLD-SPACE POSITIONING ---
vec3 fdx = dFdx(positionXYZ);
vec3 fdy = dFdy(positionXYZ);
vec3 normal = normalize(cross(fdx, fdy));
vec3 absNormal = abs(normal);

vec2 projectedCoords;
if (absNormal.y > absNormal.x && absNormal.y > absNormal.z) {
projectedCoords = positionXYZ.xz;
} else if (absNormal.x > absNormal.z) {
projectedCoords = positionXYZ.zy;
} else {
projectedCoords = positionXYZ.xy;
}
// ----------------------------------------------------

// 3. LIQUID DOMAIN WARPING (Nested Fluid Math)
vec2 uv = projectedCoords * NOISE_SCALE;

// Create a primary distortion vector (Offset coordinates over time)
vec2 q = vec2(
fluidFBM(uv + vec2(time * 0.01, time * 0.005)),
fluidFBM(uv + vec2(time * 0.008, -time * 0.012))
);

// Create a secondary distortion vector fed by the first one (creates swirling eddies)
vec2 r = vec2(
fluidFBM(uv + 4.0 * q + vec2(time * 0.015, 2.5)),
fluidFBM(uv + 4.0 * q + vec2(5.2, time * 0.009))
);

// Final heavily warped liquid coordinates
vec2 liquidUV = uv + 3.0 * r;

// 4. Sample the Fluid Noise maps using warped space
float densityA = fluidFBM(liquidUV);
float densityB = fluidFBM(liquidUV + vec2(1.5, -2.3));

// Combine and smoothly map the liquid pools
float liquidMask = mix(densityA, densityB, 0.5);
liquidMask = smoothstep(0.15, 0.80, liquidMask);

// 5. High-Saturation / High-Vibrancy Balatro Palette
// Hue flows and cycles inside the liquid swirls based on the warp depth
float baseHue = fract(time * 0.001 + densityA * 0.2);
float accentHue = fract(baseHue + 0.35 + (r.x * 0.15));

vec3 primaryColor  = hsv2rgb(vec3(baseHue, 1.0, 0.95));
vec3 neonAccent    = hsv2rgb(vec3(accentHue, 1.0, 0.90));
vec3 neonHighlight = hsv2rgb(vec3(accentHue + 0.1, 0.7, 1.0));

// Composite the moving paint colors together
vec3 finalLiquidColor = mix(primaryColor, neonAccent, densityB);
// Add bright liquid reflections on the crests of the swirls
finalLiquidColor += neonHighlight * pow(liquidMask, 3.0) * 0.7;

// 6. Deep Retro Dark Velvet Canvas Background
vec3 nightSkyBackground = vec3(0.02, 0.01, 0.04);

// 7. Combine Layers
vec3 finalRGB = (baseColor.rgb * vertexColor.rgb) + nightSkyBackground + (finalLiquidColor * liquidMask * 1.3);
float finalAlpha = max(baseColor.a, 1.0) * vertexColor.a * ColorModulator.a;

// --- CRT SCANLINE OVERLAY ---
float scanline = sin(texCoord0.y * 500.0) * 0.06 + 0.94;
finalRGB *= scanline;

// 8. Final Output
fragColor = vec4(finalRGB, finalAlpha) * ColorModulator;
fragColor.rgb = max(fragColor.rgb, finalLiquidColor * liquidMask * 0.8 + nightSkyBackground);
}